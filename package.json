  "description": "Open-source framework built on blamejs. Vendored stack, zero npm runtime deps, PQC-first crypto, security-on by default.",
  "main": "lib/index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js",
    "e2e": "node test/e2e/drive-checkout.js && node test/e2e/drive-account-subscriptions.js",
    "e2e:checkout": "node test/e2e/drive-checkout.js",
    "e2e:account": "node test/e2e/drive-account-subscriptions.js",
    "vendor": "bash scripts/vendor-update.sh",
    "sync-assets": "node scripts/sync-r2-assets.js",
    "d1-export": "node scripts/d1-export.js",
    "release": "node scripts/release.js"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "files": [
    "lib/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "framework",
    "blamejs",
    "post-quantum",
    "ml-kem-1024",
    "ml-dsa-65",
    "xchacha20-poly1305",
    "security-first",
    "zero-dependency",
    "vendored"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blamejs/blamejs.shop.git"
  },
  "homepage": "https://blamejs.shop",
  "devDependencies": {
    "@cloudflare/containers": "^0.3.4",
    "wrangler": "^4.95.0"
  }
