# blamejs.shop — environment reference
#
# Copy what you need into your deployment secrets (`wrangler secret put NAME`)
# or a local `.env`. NOTHING here is required to boot a browsable storefront;
# each block enables an optional capability. A signed-in operator sees the live
# status of each integration at /admin/integrations. See the README
# "Optional integrations" section for the setup steps behind each one.

# ── Core platform ───────────────────────────────────────────────────────────
# Vault unlock — required by b.vault for sealed cookies (admin/customer
# sessions, OAuth state) and at-rest encryption. Generate 32 random bytes.
VAULT_PASSPHRASE=

# Cloudflare D1 bridge (the Workers + container topology). Without these the
# data layer is absent and the shop runs in a minimal identity-only mode.
D1_BRIDGE_URL=
D1_BRIDGE_SECRET=
# D1_BRIDGE_PATH=/_/db/query   # override only if your worker route differs

# Public origin of the deployed shop (scheme + host, no trailing slash).
# Used to build exact OAuth redirect URIs, e.g. https://shop.example.com
SHOP_ORIGIN=

# ── Admin console ───────────────────────────────────────────────────────────
# Enables the bearer-token JSON API + the /admin browser console (sign-in,
# setup wizard, dashboard). Use a 32-byte random secret (≥ 16 chars required).
ADMIN_API_KEY=

# ── Card checkout (Stripe) ──────────────────────────────────────────────────
# Enables checkout, the Payment Element, refunds, and subscription billing.
# Point your Stripe webhook at <SHOP_ORIGIN>/api/webhooks/stripe.
# Apple Pay + Google Pay (the Express Checkout Element) also need these AND a
# one-time domain registration: POST /admin/payment-method-domains
#   { "domain_name": "shop.example.com" }   (no Apple Developer account needed).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── PayPal checkout (Orders v2) ─────────────────────────────────────────────
# Adds a native PayPal button to /checkout (distinct from PayPal-through-Stripe).
# Create a PayPal REST app for the client id + secret; PAYPAL_ENV picks the live
# or sandbox API. Point a PayPal webhook at <SHOP_ORIGIN>/api/webhooks/paypal and
# allow www.paypal.com in your CSP script-src/frame-src. Stripe checkout must be
# live too (checkout mounts under it).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── Sign in with Google (OIDC) ──────────────────────────────────────────────
# Adds a "Continue with Google" button to /account/login. Create a Google Cloud
# OAuth 2.0 Web client; add <SHOP_ORIGIN>/account/auth/google/callback as an
# Authorized redirect URI; consent-screen scopes: openid email profile.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Sign in with Apple (OIDC) ───────────────────────────────────────────────
# Adds a "Continue with Apple" button to /account/login. Requires an Apple
# Developer Program membership. Create a Services ID (this is APPLE_CLIENT_ID),
# enable Sign in with Apple on it, and add <SHOP_ORIGIN>/account/auth/apple/
# callback as a Return URL; create a Sign-in-with-Apple key and paste the .p8
# contents as APPLE_PRIVATE_KEY (literal newlines or \n-escaped both work). The
# shop mints Apple's ES256 client secret from the key at boot.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# ── Other deployment secrets (see docs/deploy-cloudflare.md) ────────────────
# AUDIT_PASSPHRASE=
# AUDIT_SIGNING_PASSPHRASE=
# BACKUP_PASSPHRASE=
# KEYCHAIN_PASSPHRASE=
