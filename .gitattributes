# Vendored blamejs — treat as immutable + binary-safe. The vendor
# manifest pins versions; CRLF/LF conversion between Windows and
# Linux checkouts must never touch the vendored tree (it ships the
# noble-post-quantum bundle with embedded base64 + other byte-sensitive
# data that would corrupt under line-ending rewrites).
lib/vendor/** -text binary

# Shell scripts MUST stay LF — they run inside Linux CI / container
# steps where bash chokes on CRLF with "$'\r': command not found".
*.sh text eol=lf

# Derived artifacts the release-notes generator owns end-to-end —
# rebuild emits LF, so pin LF here too. Without this, Windows
# checkouts get CRLF and the `--check` drift gate in smoke would have
# to keep eating the cost of normalizing both sides.
CHANGELOG.md text eol=lf
release-notes/*.json text eol=lf

# Native modules — always binary.
*.node binary
*.so binary
*.dylib binary
*.dll binary
*.a binary

# Standard binary types.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.pdf binary

# Vendored web fonts — binary, never line-ending-converted.
*.woff2 binary
*.woff binary

# Theme text assets are hashed for Subresource Integrity and feed the
# asset-manifest drift gate (smoke `generate-asset-manifest.js --check`).
# The sha384 digest must be byte-stable across Windows/Linux checkouts
# AND match the exact bytes served from R2, or the browser rejects the
# resource. Pin LF (like the changelog / release-notes drift artifacts
# above) so the working copy, git, CI, and the served object all agree.
themes/**/*.css text eol=lf
themes/**/*.js text eol=lf

# The generated asset manifests are compared byte-for-byte by the same
# drift gate (`--check` reads the committed file and diffs the rebuild,
# which emits LF). Pin LF so a Windows checkout doesn't turn them CRLF
# and fail the diff against the LF rebuild.
lib/asset-manifest.json text eol=lf
worker/asset-manifest.json text eol=lf

# The vendored-dependency SBOM is a committed, byte-compared derived
# artifact (smoke `build-vendored-sbom.js --check` diffs the committed
# file against the LF-emitting rebuild). Pin LF so a Windows checkout
# doesn't smudge it to CRLF and trip the drift gate.
sbom.vendored.cdx.json text eol=lf
